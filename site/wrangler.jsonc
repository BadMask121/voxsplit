{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voxsplit-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // The page and its assets. The Worker runs first on every path: it redirects the old
  // host, fills the current release (release.json) into the page and install.sh, and
  // serves downloads from R2; everything else it hands to the asset handler.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Installers are too big for static assets (25 MiB cap): they live in R2.
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "voxsplit-downloads" }],
  // Home: voxsplit.jeffrey.build. The first home, voxsplit.triplejmusic.art, stays
  // attached only so the Worker can redirect it (triplejmusic.art itself is the Triple J
  // press kit: never touch it). The Worker must run first everywhere for that redirect.
  "routes": [
    { "pattern": "voxsplit.jeffrey.build", "custom_domain": true },
    { "pattern": "voxsplit.triplejmusic.art", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
